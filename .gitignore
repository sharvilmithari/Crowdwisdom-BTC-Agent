!data/raw/x/btc_x_live_test.json
!data/processed/x_features_1h.parquet
!data/processed/feature_matrix_180d.parquet
!data/**/.gitkeep
!models/.gitkeep
!logs/.gitkeep
!reports/.gitkeep

# Models (exclude binary weights if needed, keep gitkeep)
models/*.pt
models/*.bin

# Logs
logs/*.log

