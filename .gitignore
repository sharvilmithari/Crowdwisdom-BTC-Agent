# Keep essential fixtures and datasets
!data/raw/prices/btc_usd_1h.csv
!data/raw/x/btc_x_historical_180d.parquet
!data/raw/x/btc_x_historical_180d.csv
!data/raw/x/historical_collection_manifest.json
