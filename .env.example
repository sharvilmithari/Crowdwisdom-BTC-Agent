# ==============================================================================
# CrowdWisdomTrading BTC X Sentiment Price Prediction Agent
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your personal API keys:
#   cp .env.example .env
#
# DO NOT commit .env to version control or expose API tokens in pull requests.
# ==============================================================================

# Apify Actor Integration (apidojo/tweet-scraper)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=apidojo/tweet-scraper

# Contextual News Search Providers (Tavily & Exa)
TAVILY_API_KEY=
EXA_API_KEY=

# Pipeline & Data Ingestion Settings
ASSET_SYMBOL=BTC-USD
DEFAULT_INTERVAL=1h
LOOKBACK_DAYS=180
DATA_DIR=data
LOG_LEVEL=INFO
